<Window x:Class="T0Prototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T0 Prototype"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="360" Height="360"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <!-- T2 透明悬浮：WPF 原生 Media3D 渲染，AllowsTransparency 下透明+输入天然正常（无 WebView2 子窗口冲突）-->
    <Grid x:Name="RootGrid" Background="Transparent" Focusable="True">
        <Viewport3D x:Name="viewport" Margin="16" />
        <!-- 透明模式无边框，拖动由代码中边缘检测处理 -->
        <TextBlock x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                   Foreground="White" Opacity="0.7" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                   IsHitTestVisible="False">左键拖拽旋转 · 左键单击面：看大图 · Shift+左键平移 · 双击复位 · 右键点面换图 · 边缘拖动窗口 · 滚轮放大窗口 · Ctrl+Shift+H 隐藏 · Ctrl+Shift+R 复位</TextBlock>
        <TextBlock x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                   Foreground="White" Background="#B0000000" Padding="6,4" FontSize="12" TextWrapping="Wrap"
                   IsHitTestVisible="False" Opacity="0">占位提示</TextBlock>
    </Grid>
</Window>
